# Paper trading (default) — copy to .env and adjust; never commit .env
STARTING_BANKROLL=10.0
MAX_POSITION_NOTIONAL=2.5
MIN_MARKET_VOLUME=10000
MIN_SPREAD_CENTS=3
TAKE_PROFIT_CENTS=2
STOP_LOSS_CENTS=3
MAX_HOLD_MINUTES=120
LOOP_SECONDS=10
MAX_MARKETS_TO_SCAN=50
MIN_PRICE=0.10
MAX_PRICE=0.90
PAPER_FILL_PROBABILITY=0.25
MIN_PRACTICAL_ORDER_NOTIONAL=0.50
DAILY_MAX_LOSS_USD=
KILL_SWITCH=false
ENABLE_LIVE_ADAPTER=false
LOG_LEVEL=INFO
DATA_DIR=./data
LOGS_DIR=./logs
GAMMA_BASE_URL=https://gamma-api.polymarket.com
CLOB_BASE_URL=https://clob.polymarket.com
HTTP_TIMEOUT_SECONDS=15.0
HTTP_MAX_RETRIES=4
RANDOM_SEED=
